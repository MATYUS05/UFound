{
  "expo": {
    "name": "UFound",
    "slug": "ufound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ufound",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ufound.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a7ea4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ufound.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a7ea4",
          "dark": {
            "backgroundColor": "#0a7ea4"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "UFound memerlukan akses kamera untuk scan barcode pengambilan barang"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UFound memerlukan lokasi untuk menentukan tempat barang ditemukan"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UFound memerlukan akses foto untuk upload gambar barang"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6308903b-b30d-447d-8604-74e636300880"
      }
    },
    "owner": "raisoh"
  }
}
